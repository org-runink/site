section_context[2]:
  - title: "Emissions, Waste and the Cost of Reading Supply Chain Records Late"
    permalink: "https://runink.org/blog/advanced-analytics-supply-chain-emissions-reduction/"
    date: "2026-06-06T02:16:21Z"
    description: "Where supply chain emissions actually come from in a wholesale network — empty miles, buffer inventory, expedites and dwell — and why the reduction levers available without capital expenditure are all reading problems rather than routing problems."
  - title: "Reconciling Complex Logistics Data Safely: Methods for Data Reliability"
    permalink: "https://runink.org/blog/reconciling-complex-data-logistics-solutions/"
    date: "2026-03-15T15:11:52Z"
    description: "Why automated systems produce confident wrong answers in supply chains, and four practical methods — better questions, reranking, embedding adapters and tuning — that keep answers tied to real records."
